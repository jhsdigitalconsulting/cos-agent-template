# Neon Postgres (event ledger, webhook payload log, sync cursors)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=

# Slack (Vercel Connect owns the app install/bot token — see lib/slack-credentials.ts)
SLACK_CONNECT_SLUG=slack/{{CLIENT_SLUG}}
SLACK_OPS_CHANNEL=

# Notifications (lib/notifications) — comma list of "slack", "teams"
NOTIFICATION_CHANNELS=slack
TEAMS_WEBHOOK_URL=

# Skynest (Context Nest) MCP vault connection — see agent/connections/ctxnest.ts.
# BOT_GITHUB_TOKEN doubles as the sandbox's git/GitHub credential for agent
# repair PRs (agent/sandbox.ts), so it needs `repo` scope on GITHUB_REPO.
CTXNEST_URL=
BOT_GITHUB_TOKEN=

# owner/repo of this agent's own repository — the agent clones it in the
# sandbox to open repair PRs (agent/tools/repair_webhook_failure.ts)
GITHUB_REPO=

# Vercel OIDC token for the eve channel's built-in auth (see agent/channels/eve.ts)
VERCEL_OIDC_TOKEN=

# app/api/hooks/example — shared secret for the worked webhook example
EXAMPLE_WEBHOOK_SECRET=
