{
  "name": "@jhsdc/cos-agent-template",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cos-agent-setup": "bin/cos-agent-setup.js"
  },
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "next build",
    "deploy": "eve deploy",
    "dev": "next dev",
    "eval": "eve eval",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "setup": "node --experimental-strip-types scripts/setup.ts",
    "init:client": "node --experimental-strip-types scripts/init-client.ts",
    "init:skynest": "node --experimental-strip-types scripts/init-skynest.ts",
    "setup:vercel": "node --experimental-strip-types scripts/vercel-setup.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-javascript": "3.23.0",
    "@shikijs/engine-oniguruma": "3.23.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/connect": "1.0.0",
    "ai": "^7.0.82",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eve": "^0.52.4",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.3.4",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "3.23.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "workflow": "^4.8.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
